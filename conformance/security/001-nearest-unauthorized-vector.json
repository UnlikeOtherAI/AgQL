{
  "format": "agql-security-probe/0.1",
  "id": "security.nearest-unauthorized-vector",
  "rfc": ["§5", "§6", "§9", "§11"],
  "rule": "The nearest vector cannot be returned when its row partition is outside the effective scope.",
  "setup": {
    "catalog": {"dataset": "memories", "idField": "memories.id", "rowScope": ["memories.tenant"], "embeddingSpec": "memory@1"},
    "scopeTemplate": {"partitions": {"memories.tenant": ["{{allowedTenant}}"]}},
    "recordsTemplate": [
      {"id": "unauthorized-{{caseIndex}}", "tenant": "{{deniedTenant}}", "vectorRelationToQuery": "identical"},
      {"id": "eligible-{{caseIndex}}", "tenant": "{{allowedTenant}}", "vectorRelationToQuery": "cosine-distance-{{eligibleDistance}}"},
      {"id": "decoy-{{caseIndex}}", "tenant": "{{deniedTenant}}", "vectorRelationToQuery": "cosine-distance-0.0001"}
    ],
    "queryTemplate": {"version": "0", "mode": "retrieve", "from": "memories", "search": {"kind": "semantic", "using": "memory@1", "text": "query {{queryShape}}", "accuracy": "{{accuracy}}", "quality": "baseline-unset-v0"}, "take": "{{take}}"}
  },
  "adversarialIntent": "Make out-of-scope vectors strictly closer than every eligible vector so post-search authorization leaks immediately.",
  "expansion": {
    "prng": "xorshift32-v1",
    "seedHex": "91e10da5",
    "caseCount": 20000,
    "selection": "One nextU32 per dimension in listed order; select values[word % values.length].",
    "dimensions": [
      {"name": "allowedTenant", "values": ["t00", "t01", "t02", "t03", "t04", "t05", "t06", "t07"]},
      {"name": "deniedTenant", "values": ["t08", "t09", "t10", "t11", "t12", "t13", "t14", "t15"]},
      {"name": "accuracy", "values": ["exact", "approximate"]},
      {"name": "take", "values": [1, 3, 10]},
      {"name": "eligibleDistance", "values": ["0.1", "0.5", "0.99"]},
      {"name": "queryShape", "values": ["axis", "tie", "negative-components", "zero-heavy"]},
      {"name": "stateOrder", "values": ["unauthorized-indexed-first", "eligible-indexed-first", "interleaved", "compacted"]}
    ]
  },
  "invariant": {"maximumViolations": 0, "failure": "fail-build", "checks": ["Every returned id has tenant == allowedTenant.", "unauthorized and decoy never cross the backend/adapter boundary as logical record content.", "The result is not padded when fewer than take eligible rows exist."]}
}
