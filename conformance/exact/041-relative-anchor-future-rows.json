  "id": "exact.records.relative-anchor-future-rows",
  "rfc": ["§3", "§5", "§11"],
  "rule": "inCurrent selects the whole calendar period around the anchor and therefore includes rows dated after the anchor; only inLast caps at the anchor. The two operators must not be conflated in either direction.",
  "requiresProfile": "records.v0",
