      {"id": "right_rows", "description": "Secondary probe rows.", "idField": "right_rows.id", "profiles": ["records.v0"], "rowScope": {"kind": "none", "reason": "Public conformance seed."}, "fields": [{"id": "right_rows.id", "description": "Stable row id.", "kind": "id", "nullable": false}]}
    ]
  },
  "scope": {"principal": "fixture:reader", "capabilities": ["records.v0", "aggregate.v0", "retrieve.semantic.v0"], "partitions": {"fixture": ["all"]}, "budgets": {"rows": 10}, "expiresAt": "2099-01-01T00:00:00Z"},
  "seed": [{"dataset": "left_rows", "record": {"id": "l-1", "value": 1}}, {"dataset": "right_rows", "record": {"id": "r-1"}}],
  "cases": [
