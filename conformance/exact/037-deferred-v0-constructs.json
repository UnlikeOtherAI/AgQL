    {"name": "edge", "query": {"version": "0", "mode": "records", "from": "left_rows", "edges": [{"name": "related"}], "select": ["left_rows.id"], "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}},
    {"name": "nested-query", "query": {"version": "0", "mode": "records", "from": "left_rows", "where": {"kind": "predicate", "field": "left_rows.id", "op": "in", "query": {"version": "0", "mode": "records", "from": "right_rows", "select": ["right_rows.id"], "order": [{"by": "right_rows.id", "dir": "asc"}], "take": 1}}, "select": ["left_rows.id"], "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}},
    {"name": "derive", "query": {"version": "0", "mode": "records", "from": "left_rows", "derive": [{"id": "twice", "expression": "left_rows.value * 2"}], "select": ["twice"], "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}},
    {"name": "merge", "query": {"version": "0", "mode": "merge", "from": "left_rows", "take": 1}},
    {"name": "percentile", "query": {"version": "0", "mode": "aggregate", "from": "left_rows", "dimensions": [], "metrics": [{"id": "p95", "op": "percentile", "field": "left_rows.value", "p": "0.95"}], "order": [{"by": "p95", "dir": "asc"}], "take": 1}},
    {"name": "rerank", "query": {"version": "0", "mode": "retrieve", "from": "left_rows", "search": {"kind": "semantic", "using": "body@1", "text": "x", "accuracy": "approximate", "quality": "baseline", "rerank": {"pipeline": "cross-encoder"}}, "take": 1}},
    {"name": "multi-vector", "query": {"version": "0", "mode": "retrieve", "from": "left_rows", "search": {"kind": "semantic", "using": ["title@1", "body@1"], "text": "x", "accuracy": "approximate", "quality": "baseline"}, "take": 1}},
    {"name": "materialized-dataset", "query": {"version": "0", "mode": "aggregate", "from": "left_rows", "dimensions": [], "metrics": [{"id": "n", "op": "count"}], "materialize": {"as": "counts"}, "order": [{"by": "n", "dir": "asc"}], "take": 1}},
    {"name": "artifact", "query": {"version": "0", "mode": "artifact", "from": "left_rows", "take": 1}},
    {"name": "publication", "query": {"version": "0", "mode": "records", "from": "left_rows", "select": ["left_rows.id"], "publish": {"audience": "public"}, "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}},
    {"name": "federation", "query": {"version": "0", "mode": "records", "from": ["left_rows", "right_rows"], "select": ["left_rows.id"], "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}},
    {"name": "attenuable-credential", "query": {"version": "0", "mode": "records", "from": "left_rows", "credential": {"attenuate": {"rows": 1}}, "select": ["left_rows.id"], "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}},
    {"name": "differential-privacy", "query": {"version": "0", "mode": "aggregate", "from": "left_rows", "dimensions": [], "metrics": [{"id": "n", "op": "count"}], "privacy": {"kind": "differential", "epsilon": "1.0"}, "order": [{"by": "n", "dir": "asc"}], "take": 1}},
    {"name": "derived-policy-propagation", "query": {"version": "0", "mode": "records", "from": "left_rows", "derive": [{"id": "copy", "field": "left_rows.value", "propagatePolicy": true}], "select": ["copy"], "order": [{"by": "left_rows.id", "dir": "asc"}], "take": 1}}
  ],
  "expected": {
    "outcomePerCase": "refusal",
    "beforeBackend": true,
    "error": {"code": "UNSUPPORTED_IN_V0", "message": "UNDETERMINED_BY_RFC_V0", "path": "UNDETERMINED_BY_RFC_V0", "alternatives": "UNDETERMINED_BY_RFC_V0"},
    "assertions": ["The construct is not silently ignored.", "No implementation-specific partial semantics run."],
    "gap": "RFC §1 fixes the code but does not reserve a wire syntax for most deferred constructs, or define per-construct paths, messages, and legal alternatives. The query members in cases are probe spellings, not a claim that these become future syntax."
