{
  "format": "agql-exact-fixture/0.1",
  "id": "exact.errors.deferred-v0-constructs",
  "rfc": ["§1", "§7", "§10"],
  "rule": "Every construct explicitly deferred from v0 is recognized as deferred and refused with UNSUPPORTED_IN_V0, never executed, ignored, or given implementation-specific semantics.",
  "requiresProfile": "records.v0",
  "catalog": {
    "version": "cat-exact-037",
    "datasets": [
