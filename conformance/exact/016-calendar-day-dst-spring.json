{
  "format": "agql-exact-fixture/0.1",
  "id": "exact.aggregate.calendar-day-dst-spring",
  "rfc": ["§2", "§5", "§11"],
  "brief": ["§3.5"],
  "rule": "A calendar day bucket is timezone-aware and spans the local civil day even when a DST transition makes it 23 hours; it is never a fixed-duration fake instant.",
  "requiresProfile": "aggregate.v0",
  "catalog": {
    "version": "cat-exact-016",
    "calendar": {"timezone": "America/New_York", "timezoneDatabase": "2024a", "weekStart": "monday", "fiscalDayStart": "00:00:00"},
    "datasets": [{
      "id": "observations",
      "description": "Instants around the 2024 New York spring-forward transition.",
      "idField": "observations.id",
      "profiles": ["aggregate.v0"],
      "rowScope": {"kind": "none", "reason": "Public conformance seed."},
      "fields": [
        {"id": "observations.id", "description": "Stable observation id.", "kind": "id", "nullable": false},
        {"id": "observations.at", "description": "UTC observation instant.", "kind": "instant", "precision": "second", "nullable": false}
      ]
    }]
  },
  "scope": {"principal": "fixture:reader", "capabilities": ["aggregate.v0"], "partitions": {"fixture": ["all"]}, "budgets": {"rows": 10}, "expiresAt": "2099-01-01T00:00:00Z"},
  "seed": [
    {"id": "before", "at": "2024-03-10T04:59:59Z"},
    {"id": "start", "at": "2024-03-10T05:00:00Z"},
    {"id": "pre-gap", "at": "2024-03-10T06:59:59Z"},
    {"id": "post-gap", "at": "2024-03-10T07:00:00Z"},
    {"id": "end-minus", "at": "2024-03-11T03:59:59Z"},
    {"id": "end", "at": "2024-03-11T04:00:00Z"}
  ],
  "query": {"version": "0", "mode": "aggregate", "from": "observations", "dimensions": [{"kind": "timeBucket", "field": "observations.at", "grain": "day", "id": "day"}], "metrics": [{"id": "n", "op": "count"}], "order": [{"by": "day", "dir": "asc"}], "take": 10},
  "expected": {
    "outcome": "success",
    "assertions": [
      "The bucket corresponding to local 2024-03-10 contains start, pre-gap, post-gap, and end-minus; it contains neither before nor end.",
      "That bucket's UTC extent is [2024-03-10T05:00:00Z, 2024-03-11T04:00:00Z), which is 23 hours.",
      "The emitted bucket is a calendar-period object with start, endExclusive, and timezone, not a fake instant."
    ],
    "semantic": {"groups": [{"day": {"start": "2024-03-09T05:00:00Z", "endExclusive": "2024-03-10T05:00:00Z", "timezone": "America/New_York", "grain": "day", "label": "2024-03-09"}, "n": 1}, {"day": {"start": "2024-03-10T05:00:00Z", "endExclusive": "2024-03-11T04:00:00Z", "timezone": "America/New_York", "grain": "day", "label": "2024-03-10"}, "n": 4}, {"day": {"start": "2024-03-11T04:00:00Z", "endExclusive": "2024-03-12T04:00:00Z", "timezone": "America/New_York", "grain": "day", "label": "2024-03-11"}, "n": 1}]}
  }
}
