  "timeline": [
    {"step": 0, "visibility": {"record": {"state": "ready", "token": "opaque:V1ItMDAyLXJlY29yZA"}, "embedding:body@2": {"state": "accepted"}}},
    {"step": 1, "event": "timeout-deadline", "visibility": {"record": {"state": "ready", "token": "opaque:V1ItMDAyLXJlY29yZA"}, "embedding:body@2": {"state": "accepted"}}}
  ],
  "query": {"version": "0", "mode": "retrieve", "from": "documents", "search": {"kind": "semantic", "using": "body@2", "text": "pending", "accuracy": "exact", "quality": "exact-oracle-v0"}, "afterWrite": {"receipt": "wr_fixture_002", "require": ["record", "embedding:body@2"], "timeoutMs": 50}, "take": 10},
  "expected": {
