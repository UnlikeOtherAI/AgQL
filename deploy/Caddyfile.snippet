# Replace agql.example.com with the public hostname served by this Caddy instance.
agql.example.com {
	encode zstd gzip

	reverse_proxy agql-api:8787 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
	}
}
