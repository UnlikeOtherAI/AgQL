# HTTP port exposed only to the shared reverse-proxy network.
AGQL_PORT=8787

# Required bearer key(s); generate one with `openssl rand -hex 32` and separate additional keys with commas.
AGQL_APP_KEYS=

# Required comma-separated catalog capability tags for the bearer-key application scope.
# Empty capabilities mean nothing is visible, so the server rejects an empty value at boot.
AGQL_APP_CAPABILITIES=portfolio,starter,work-items

# Absolute path to the catalog packaged in the container.
AGQL_CATALOG_PATH=/app/examples/starter/catalog.json

# PostgreSQL database name created by the private database container.
POSTGRES_DB=agql

# PostgreSQL role created by the private database container.
POSTGRES_USER=agql

# Required PostgreSQL password; generate a distinct value with `openssl rand -hex 32`.
POSTGRES_PASSWORD=

# Required server connection URL; use the same generated PostgreSQL password and the hostname agql-postgres.
DATABASE_URL=

# Optional embedder selection; leave this commented out unless your server configuration defines a supported value.
# AGQL_EMBEDDER=

# Server log verbosity.
AGQL_LOG_LEVEL=info
